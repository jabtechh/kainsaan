# Example environment variables for Kain Saan
# Copy this file to .env and fill in your actual values

# Django settings
SECRET_KEY=your-secret-key-here-generate-a-random-string
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,your-app.onrender.com

# Database (for local development with docker-compose)
DB_NAME=kainsaan
DB_USER=kainsaan_user
DB_PASSWORD=your-secure-password
DB_HOST=db
DB_PORT=5432

# Database URL (for Render/Heroku-style deployments)
# DATABASE_URL=postgresql://user:password@host:port/database

# Google APIs
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
